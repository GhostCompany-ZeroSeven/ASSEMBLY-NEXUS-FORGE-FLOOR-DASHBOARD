# Build mode used ONLY by the Playwright REST e2e/visual suite (`npm run build:e2e-rest`).
# Points the GenericRESTAdapter at a mock backend that Playwright intercepts in the browser.
# VITE_* values are compiled into the client bundle: never put secrets here.
VITE_FORGE_ADAPTER=rest
VITE_FORGE_REST_BASE_URL=http://mock-backend.test/api
VITE_FORGE_REST_LABEL=E2E mock backend
# Contract profile declared by this build (domain/contract/profiles.ts): the mock contract, NOT Assembly Nexus.
VITE_FORGE_CONTRACT_PROFILE=mock
