# Build mode used ONLY by the Playwright runtime suite (`npm run build:e2e-runtime`).
# Served by scripts/mock-runtime-server.ts together with a SAME-ORIGIN mock backend
# (HTTP + Server-Sent Events) under /mockapi. Not the Assembly Nexus contract.
# VITE_* values are compiled into the client bundle: never put secrets here.
VITE_FORGE_ADAPTER=rest
VITE_FORGE_REST_BASE_URL=/mockapi
VITE_FORGE_REST_STREAM=/stream
VITE_FORGE_REST_LABEL=E2E runtime mock backend
VITE_FORGE_REST_POLL_MS=1000
VITE_FORGE_REST_RESYNC_MS=2000
# Contract profile declared by this build (domain/contract/profiles.ts): the mock contract, NOT Assembly Nexus.
VITE_FORGE_CONTRACT_PROFILE=mock
