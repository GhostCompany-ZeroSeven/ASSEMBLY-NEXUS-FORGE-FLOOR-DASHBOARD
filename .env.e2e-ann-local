# Build mode used ONLY by the Playwright ann-local suite (`npm run build:e2e-ann-local`).
# Selects the read-only ANN v1 adapter over the OPTIONAL local snapshot host, which
# the suite itself starts on 127.0.0.1:4391 with a temporary fixture snapshot.
# Loopback only; no Assembly Nexus system, no credentials, no filesystem path.
# VITE_* values are compiled into the client bundle: never put secrets here.
VITE_FORGE_ADAPTER=ann-local
VITE_FORGE_ANN_LOCAL_ENDPOINT=http://127.0.0.1:4391/ann/snapshot
